# Rewind server configuration, read by systemd (EnvironmentFile= in
# rewind.service). Installed as /etc/rewind/rewind.env, owned by root, group
# rewind, mode 0640. The installer changes an existing file only through its
# wizard (sudo rewind-ctl --reconfigure), after you confirm, and saves the
# previous version in /var/backups/rewind first. Other lines are kept.
#
# Plain KEY=value lines, no quotes. Restart after a change:
#   sudo systemctl restart rewind
# Every setting, with its default and allowed values, is described in
# docs/configuration.md. Settings not listed here keep their defaults.

# Data directory: database (rewind.db) and, until the owner account exists,
# the one-time setup code (setup-code). Must stay writable by the rewind user;
# rewind.service allows writes to /var/lib/rewind only.
REWIND_DATA_DIR=/var/lib/rewind

# Listen address. The default is reachable from this server only. Keep
# 127.0.0.1:8090 in the list even after enabling remote access: install.sh
# and the health checks use it. See "Network access" in docs/deployment.md.
REWIND_ADDR=127.0.0.1:8090

# Music folders: absolute paths of mounted drives or directories, separated
# by ':'. Mount the drive first; Rewind never mounts or writes to it. The
# rewind user needs read access. Example (use your own mount path):
#   REWIND_LIBRARY_ROOTS=/srv/usb-music
#   REWIND_LIBRARY_ROOTS=/srv/usb-music:/srv/more-music
REWIND_LIBRARY_ROOTS=

# Remote access (off by default). For HTTPS through `tailscale serve`, the
# recommended layout, keep REWIND_ADDR as above and set:
#   REWIND_TRUSTED_HOSTS=yourserver.tailXXXX.ts.net
#   REWIND_COOKIE_SECURE=true
# For plain HTTP on a LAN or Tailscale IP, read docs/deployment.md first:
#   REWIND_REMOTE_ACCESS=true
#   REWIND_ADDR=127.0.0.1:8090,192.168.1.20:8090

# Logs go to the journal (journalctl -u rewind).
REWIND_LOG_LEVEL=info
