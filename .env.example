# Rewind configuration template.
#
# Rewind reads these settings from environment variables only; it does not
# load .env files itself. Copy this file to .env (git-ignored), then load it
# into your shell or point systemd's EnvironmentFile= at it. See
# docs/development.md. Use plain KEY=value lines without quotes.
# Every setting is optional; the values shown are the defaults.

# Addresses the server listens on: one or more host:port entries separated by
# commas. Hosts must be IP addresses or localhost. The default is reachable
# from this machine only. See "Network access" in docs/deployment.md before
# changing it.
REWIND_ADDR=127.0.0.1:8090

# Allow non-loopback addresses (your LAN or Tailscale IP) in REWIND_ADDR.
# Example: REWIND_ADDR=127.0.0.1:8090,192.168.1.20:8090
# Other devices then reach the sign-in page; a password is still required.
REWIND_REMOTE_ACCESS=false

# Also allow 0.0.0.0, [::] or :port (every interface, including public ones).
# Needs REWIND_REMOTE_ACCESS=true. A specific address is safer.
REWIND_LISTEN_ALL_INTERFACES=false

# Extra host names (or IPs) accepted in the browser's address bar, separated
# by commas, besides localhost and the IP addresses listed in REWIND_ADDR.
# Exact names only: no wildcards, ports or https://. Example for
# tailscale serve:
#   REWIND_TRUSTED_HOSTS=rewind.tail1234.ts.net
REWIND_TRUSTED_HOSTS=

# Application-data directory. It holds the SQLite database (rewind.db) and,
# until the owner account exists, the one-time setup code (setup-code).
# Relative paths are resolved against the working directory. A missing
# directory is created with mode 0700. Back up this directory; it never
# contains music. Recommended for a server: /var/lib/rewind
REWIND_DATA_DIR=data

# Absolute lifetime of a login session (Go duration, 5m to 8760h).
REWIND_SESSION_LIFETIME=720h

# A session unused for this long is ended (Go duration, at least 5m; capped at
# the lifetime).
REWIND_SESSION_IDLE_TIMEOUT=168h

# Mark the session cookie Secure so browsers send it only over HTTPS. Leave
# false for plain HTTP (loopback, LAN or a Tailscale IP); set true when remote
# clients use HTTPS, for example through tailscale serve.
REWIND_COOKIE_SECURE=false

# Music folders to index, as absolute paths separated by ':' (';' on
# Windows). Mount the drive first; Rewind never mounts or writes to it. A new
# folder must exist when first configured; known folders that are unplugged
# later are kept, with their tracks. Example (use your own mount path):
#   REWIND_LIBRARY_ROOTS=/media/you/MUSICSTICK
REWIND_LIBRARY_ROOTS=

# Scan all library folders in the background at startup. Rescans can also be
# requested later with POST /api/library/scan.
REWIND_SCAN_ON_STARTUP=true

# Files read in parallel during a scan (1-8). More rarely helps on USB drives.
REWIND_SCAN_WORKERS=2

# Largest page size (`limit`) accepted by paginated API endpoints (10-1000).
REWIND_API_MAX_PAGE_SIZE=200

# Minimum log level: debug | info | warn | error.
REWIND_LOG_LEVEL=info

# Log output format: text | json.
REWIND_LOG_FORMAT=text

# Plugins (optional; see docs/plugins.md). Plugins are compiled into Rewind
# and are trusted code that runs with Rewind's privileges. They are off unless
# a directory is set, and only the IDs listed in REWIND_PLUGINS ever run.
# The directory holds one <id>/plugin.json manifest per plugin. Use an
# absolute path outside the data directory and the music folders, writable
# only by the administrator. Changes take effect after a restart.
#   REWIND_PLUGIN_DIR=/etc/rewind/plugins
#   REWIND_PLUGINS=missing-tracks
REWIND_PLUGIN_DIR=
REWIND_PLUGINS=
